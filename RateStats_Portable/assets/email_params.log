# ============================================================
# 每日结果邮件配置（key=value）
# 修改规则：
# - 只改等号右边，不改等号左边的 key 名
# - 井号 # 开头是说明，不参与运行
# - 保存后直接运行 03_一键生成Market+彩虹表.bat 即可
# ============================================================
#
# -------------------------
# [A] 总开关（必填）
# -------------------------
# true  = 允许发送邮件
# false = 不发送邮件（即使在 bat 里选了 Y，也会跳过）
email_enabled=true
#
# 若出现 535 / basic authentication is disabled：说明学校/微软租户已禁止「SMTP 基本身份验证」，
# 脚本无法仅靠账号密码发信。需 NUS IT 为该邮箱开启 SMTP AUTH，或换用允许 SMTP 的邮箱发报表。
# 说明：https://learn.microsoft.com/exchange/clients-and-mobile-in-exchange-online/authenticated-client-smtp-submission
#
# 发邮件：运行 03 批处理结束后按 Y 发送、N 跳过；记录见 assets\email_last_run.log。
#
# -------------------------
# [B] SMTP 服务器（必填）
# -------------------------
# 你的邮箱服务商 SMTP 地址，例如：
# - QQ邮箱: smtp.qq.com
# - 163邮箱: smtp.163.com
# - Gmail: smtp.gmail.com
smtp_host=smtp.qq.com
#
# SMTP 端口，常见：
# - 465 (SSL)
# - 587 (TLS)
smtp_port=465
#
# true  = 使用 SSL（通常配 465）
# false = 使用 TLS（通常配 587）
smtp_ssl=true
#
# SMTP 登录账号（通常是完整邮箱地址）
smtp_user=779700898@qq.com
#
# SMTP 登录密码：微软/学校邮箱常为「应用密码」或专用 SMTP 密码；勿把真实密码提交到 Git。
smtp_password=uwhszlanlvgybced
#
# -------------------------
# [C] 发件人与收件人（必填）
# -------------------------
# 发件人邮箱（通常与 smtp_user 一致）
from_email=779700898@qq.com
#
# 收件人，多个用英文逗号分隔
# 示例：a@example.com,b@example.com
to_emails=779700898@qq.com
# to_emails=WangYannan@sg.bank-of-china.com
#
# 抄送，可留空；多个同样用英文逗号分隔
cc_emails=
#
# -------------------------
# [D] 邮件标题与正文模板（选填）
# -------------------------
# 可用变量：
# - {date}         -> 当天日期，如 20260507
# - {market_name}  -> Market 文件名
# - {rainbow_name} -> 彩虹表文件名
subject_template=每日利率结果 {date}
body_template=附件为 {date} 的 MarketRateData 与彩虹表，请查收。文件：{market_name}，{rainbow_name}

