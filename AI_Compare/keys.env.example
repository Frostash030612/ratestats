# 复制本文件为 keys.env（勿提交 Git），填入 Key 后在 PowerShell 中：
#   Get-Content keys.env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process') } }
#
# 或直接在 PowerShell 里：
#   $env:SERPER_API_KEY = "..."
#   $env:BRAVE_API_KEY  = "..."
#   $env:TAVILY_API_KEY = "tvly-..."

SERPER_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=
